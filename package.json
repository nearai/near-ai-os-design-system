{
  "name": "near-ai-os-design-system",
  "version": "1.0.0",
  "private": true,
  "description": "Near AI OS Design System: tokens, component styles and guidelines for Near AI products on desktop, web, tablet and phone.",
  "files": [
    "dist",
    "assets"
  ],
  "exports": {
    "./tokens.css": "./dist/css/tokens.css",
    "./near-ai.css": "./dist/css/near-ai.css",
    "./tailwind.css": "./dist/tailwind/theme.css",
    "./tokens.json": "./dist/artifact/tokens.json",
    "./dtcg/*": "./dist/dtcg/*",
    "./assets/*": "./assets/*"
  },
  "scripts": {
    "build": "python3 scripts/build.py",
    "check": "python3 scripts/check.py",
    "previews": "python3 scripts/preview.py --all light,dark"
  }
}
